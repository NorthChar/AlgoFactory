    <node id="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:algorithm_tfidf_logreg">
      <data key="d2">Algorithm</data>
      <data key="d3">TF-IDF + Logistic Regression</data>
      <data key="d4">source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840</data>
      <data key="d5">{"applicability":{"data_kind":"text","requirements":["English text","fixed data version and category mapping"],"schema_version":1,"task_types":["multiclass_classification"]},"family":"Linear Text Classification","id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:algorithm_tfidf_logreg","name":"TF-IDF + Logistic Regression","schema_version":1,"source_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840","source_span":{"end":628,"quote":"TF-IDF + Logistic Regression 属于线性文本分类模型，可以实现上述客服意图分类能力。使用词级一元和二元 TF-IDF、sublinear_tf=True、max_features=30000；LogisticRegression 的 C=4.0、max_iter=500、random_state=42。特征提取与分类器放在同一 Pipeline，适用于上述英文文本多分类任务。","schema_version":1,"start":426},"type":"Algorithm"}</data>
    </node>
    <node id="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:capability_intent_classification">
      <data key="d2">Capability</data>
      <data key="d3">Intent Classification</data>
      <data key="d4">source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840</data>
      <data key="d5">{"conditions":{"data_kind":"text","requirements":["supervised labels","fixed data version and category mapping"],"schema_version":1,"task_types":["multiclass_classification"]},"description":"Classifies customer intents from English text into 77 predefined categories.","id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:capability_intent_classification","inputs":["text","training labels"],"metrics":["Macro-F1","Accuracy","Precision","Recall","F1","Confusion Matrix"],"name":"Intent Classification","outputs":["intent category","probabilities"],"schema_version":1,"source_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840","source_span":{"end":424,"quote":"客服意图分类能力接收英文文本和训练标签，输出意图类别及按固定类别顺序排列的概率。适用条件是有监督标签的文本多分类。使用固定数据版本与类别映射；仅在训练集拟合词表和 IDF。评价指标为 Macro-F1 与 Accuracy，同时报告逐类 Precision/Recall/F1 和混淆矩阵；阈值通过训练/验证基线校准并在最终测试前冻结。","schema_version":1,"start":256},"type":"Capability"}</data>
    </node>
    <node id="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:dependency_scikit_learn">
      <data key="d2">Dependency</data>
      <data key="d3">scikit-learn</data>
      <data key="d4">source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840</data>
      <data key="d5">{"id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:dependency_scikit_learn","name":"scikit-learn","package":"scikit-learn","schema_version":1,"source_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840","source_span":{"end":741,"quote":"实现依赖 scikit-learn，版本约束 &gt;=1.5,&lt;2。当前只生成一个候选，零次自动修复；Docker 执行预算为 120 秒、2 CPU、4096 MiB，禁网。本材料描述待验证方案，不提供模型成绩或已验证经验。","schema_version":1,"start":630},"type":"Dependency","version_constraint":"&gt;=1.5,&lt;2"}</data>
    </node>
    <node id="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:task_banking77">
      <data key="d2">Task</data>
      <data key="d3">BANKING77 Intent Classification</data>
      <data key="d4">source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840</data>
      <data key="d5">{"constraints":{"allowed_algorithms":["source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:algorithm_tfidf_logreg"],"candidate_limit":1,"execution":{"backend":"docker","cpus":2,"fail_closed":true,"memory_mib":4096,"network":false,"schema_version":1,"timeout_seconds":120},"max_repairs_per_candidate":0,"schema_version":1},"id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:task_banking77","name":"BANKING77 Intent Classification","schema_version":1,"source_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840","source_span":{"end":254,"quote":"本材料由 AlgoFactory 项目编写。数据来自 PolyAI 的 BANKING77，论文 Efficient Intent Detection with Dual Sentence Encoders（Casanueva 等，2020），https://arxiv.org/abs/2003.04807，许可 CC BY 4.0。任务是英文文本多分类，输入 text，目标 intent 是 77 类已知客服意图；不包含自动回复、中文效果或未知意图检测。","schema_version":1,"start":24},"task_type":"multiclass_classification","type":"Task"}</data>
    </node>
