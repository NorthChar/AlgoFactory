    <edge source="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:algorithm_tfidf_logreg" target="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:task_banking77" id="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:relation_algorithm_applicable_to_task">
      <data key="d6">APPLICABLE_TO</data>
      <data key="d7">{"head_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:algorithm_tfidf_logreg","id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:relation_algorithm_applicable_to_task","schema_version":1,"source_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840","source_span":{"end":628,"quote":"TF-IDF + Logistic Regression 属于线性文本分类模型，可以实现上述客服意图分类能力。使用词级一元和二元 TF-IDF、sublinear_tf=True、max_features=30000；LogisticRegression 的 C=4.0、max_iter=500、random_state=42。特征提取与分类器放在同一 Pipeline，适用于上述英文文本多分类任务。","schema_version":1,"start":426},"tail_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:task_banking77","type":"APPLICABLE_TO"}</data>
    </edge>
    <edge source="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:algorithm_tfidf_logreg" target="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:capability_intent_classification" id="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:relation_algorithm_implements_capability">
      <data key="d6">IMPLEMENTS</data>
      <data key="d7">{"head_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:algorithm_tfidf_logreg","id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:relation_algorithm_implements_capability","schema_version":1,"source_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840","source_span":{"end":628,"quote":"TF-IDF + Logistic Regression 属于线性文本分类模型，可以实现上述客服意图分类能力。使用词级一元和二元 TF-IDF、sublinear_tf=True、max_features=30000；LogisticRegression 的 C=4.0、max_iter=500、random_state=42。特征提取与分类器放在同一 Pipeline，适用于上述英文文本多分类任务。","schema_version":1,"start":426},"tail_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:capability_intent_classification","type":"IMPLEMENTS"}</data>
