    <edge source="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:task_banking77" target="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:capability_intent_classification" id="source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:relation_task_requires_capability">
      <data key="d6">REQUIRES</data>
      <data key="d7">{"head_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:task_banking77","id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:relation_task_requires_capability","schema_version":1,"source_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840","source_span":{"end":254,"quote":"本材料由 AlgoFactory 项目编写。数据来自 PolyAI 的 BANKING77，论文 Efficient Intent Detection with Dual Sentence Encoders（Casanueva 等，2020），https://arxiv.org/abs/2003.04807，许可 CC BY 4.0。任务是英文文本多分类，输入 text，目标 intent 是 77 类已知客服意图；不包含自动回复、中文效果或未知意图检测。","schema_version":1,"start":24},"tail_id":"source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:capability_intent_classification","type":"REQUIRES"}</data>
    </edge>
