    <node id="source:b07ff4609755bb9dc34b0e3dfd8d088c0fd579f5b4f8e0900e9f989af6a3a59f:algorithm:logistic_regression">
      <data key="d2">Algorithm</data>
      <data key="d3">Ridge Regression</data>
      <data key="d4">source:b07ff4609755bb9dc34b0e3dfd8d088c0fd579f5b4f8e0900e9f989af6a3a59f</data>
      <data key="d5">{"applicability":{"data_kind":"tabular","requirements":["数值特征","连续标签","仅训练拟合"],"schema_version":1,"task_types":["regression"]},"family":"linear_regression","id":"source:b07ff4609755bb9dc34b0e3dfd8d088c0fd579f5b4f8e0900e9f989af6a3a59f:algorithm:logistic_regression","name":"Ridge Regression","schema_version":1,"source_id":"source:b07ff4609755bb9dc34b0e3dfd8d088c0fd579f5b4f8e0900e9f989af6a3a59f","source_span":{"end":378,"quote":"AlgoFactory 合成回归扩展示例\n本材料是项目自编的公开演示，不含真实业务数据。任务为有监督表格回归：x1、x2、x3 是数值特征，value 是连续目标，row_id 和目标不得作为特征。输出连续预测值，不提供分类概率。训练、验证、测试按固定种子独立划分，预处理只在训练集拟合。\n回归能力使用 Ridge Regression：SimpleImputer(strategy=median)、StandardScaler、Ridge(alpha=1.0) 放入 Pipeline，通过 ColumnTransformer 选择数值列。依赖为 scikit-learn。指标是 MAE 和 RMSE，越低越好；冻结门槛由主机协议提供，不使用测试集调参。生成代码仅在禁网、非 root Docker 中执行，120 秒、2 CPU、4096 MiB。\n","schema_version":1,"start":0},"type":"Algorithm"}</data>
    </node>
    <node id="source:b07ff4609755bb9dc34b0e3dfd8d088c0fd579f5b4f8e0900e9f989af6a3a59f:capability:regression">
