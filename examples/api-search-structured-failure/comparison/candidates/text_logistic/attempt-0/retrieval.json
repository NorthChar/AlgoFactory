  {
    "record": {
      "conditions": {
        "data_kind": "text",
        "requirements": [
          "supervised labels",
          "fixed data version and category mapping"
        ],
        "schema_version": 1,
        "task_types": [
          "multiclass_classification"
        ]
      },
      "description": "Classifies customer intents from English text into 77 predefined categories.",
      "id": "source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840:capability_intent_classification",
      "inputs": [
        "text",
        "training labels"
      ],
      "metrics": [
        "Macro-F1",
        "Accuracy",
        "Precision",
        "Recall",
        "F1",
        "Confusion Matrix"
      ],
      "name": "Intent Classification",
      "outputs": [
        "intent category",
        "probabilities"
      ],
      "schema_version": 1,
      "source_id": "source:3dde8ad7a184814bbf10b4c8afcc4c9bdc739d84d4bcb00a2cb6e4dd1a0ca840",
      "source_span": {
        "end": 424,
        "quote": "客服意图分类能力接收英文文本和训练标签，输出意图类别及按固定类别顺序排列的概率。适用条件是有监督标签的文本多分类。使用固定数据版本与类别映射；仅在训练集拟合词表和 IDF。评价指标为 Macro-F1 与 Accuracy，同时报告逐类 Precision/Recall/F1 和混淆矩阵；阈值通过训练/验证基线校准并在最终测试前冻结。",
        "schema_version": 1,
        "start": 256
      },
      "type": "Capability"
    },
