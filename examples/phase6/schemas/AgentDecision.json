{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "decision_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Decision Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "knowledge",
        "builder",
        "review"
      ],
      "title": "Role",
      "type": "string"
    },
    "action": {
      "enum": [
        "GENERATE",
        "REPAIR",
        "OPTIMIZE",
        "SWITCH",
        "ACCEPT",
        "STOP"
      ],
      "title": "Action",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9_.:-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "budget_remaining": {
      "minimum": 0,
      "title": "Budget Remaining",
      "type": "integer"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "role",
    "action",
    "reason",
    "evidence_ids",
    "budget_remaining"
  ],
  "title": "AgentDecision",
  "type": "object"
}
