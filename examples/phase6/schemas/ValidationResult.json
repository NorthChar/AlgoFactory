{
  "$defs": {
    "DimensionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "details": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Details",
          "type": "string"
        }
      },
      "required": [
        "status",
        "details"
      ],
      "title": "DimensionResult",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "peak_memory_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Mib"
        }
      },
      "required": [
        "elapsed_seconds"
      ],
      "title": "ResourceUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Run Id",
      "type": "string"
    },
    "implementation_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Implementation Id",
      "type": "string"
    },
    "code_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Code Hash",
      "type": "string"
    },
    "config_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "split_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Split Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "stopped"
      ],
      "title": "Status",
      "type": "string"
    },
    "functional": {
      "$ref": "#/$defs/DimensionResult"
    },
    "metrics": {
      "$ref": "#/$defs/DimensionResult"
    },
    "stability": {
      "$ref": "#/$defs/DimensionResult"
    },
    "interface": {
      "$ref": "#/$defs/DimensionResult"
    },
    "validation_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "enum": [
          "f1",
          "roc_auc",
          "precision",
          "recall",
          "mae",
          "rmse",
          "macro_f1",
          "accuracy"
        ]
      },
      "title": "Validation Metrics",
      "type": "object"
    },
    "test_metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "enum": [
          "f1",
          "roc_auc",
          "precision",
          "recall",
          "mae",
          "rmse",
          "macro_f1",
          "accuracy"
        ]
      },
      "title": "Test Metrics",
      "type": "object"
    },
    "final_test_evaluated": {
      "default": false,
      "title": "Final Test Evaluated",
      "type": "boolean"
    },
    "resources": {
      "$ref": "#/$defs/ResourceUsage"
    },
    "report_paths": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Report Paths",
      "type": "array"
    },
    "error_category": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Category"
    }
  },
  "required": [
    "run_id",
    "implementation_id",
    "code_hash",
    "config_hash",
    "split_id",
    "status",
    "functional",
    "metrics",
    "stability",
    "interface",
    "validation_metrics",
    "resources",
    "report_paths"
  ],
  "title": "ValidationResult",
  "type": "object"
}
