{
  "$defs": {
    "ExperienceScope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "task_profile": {
          "const": "banking77",
          "default": "banking77",
          "title": "Task Profile",
          "type": "string"
        },
        "task_type": {
          "const": "multiclass_classification",
          "default": "multiclass_classification",
          "title": "Task Type",
          "type": "string"
        },
        "data_kind": {
          "const": "text",
          "default": "text",
          "title": "Data Kind",
          "type": "string"
        },
        "input_container": {
          "const": "pandas_dataframe",
          "default": "pandas_dataframe",
          "title": "Input Container",
          "type": "string"
        },
        "algorithm": {
          "enum": [
            "text_logistic",
            "text_nb"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "text_features": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Text Features",
          "type": "array"
        },
        "data_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Fingerprint",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "split_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Split Id",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "data_fingerprint",
        "config_hash",
        "split_id"
      ],
      "title": "ExperienceScope",
      "type": "object"
    },
    "RepairEvidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "rule": {
          "enum": [
            "text_dataframe_adapter",
            "unclassified"
          ],
          "title": "Rule",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ExperienceScope"
        },
        "failed_run_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Failed Run Id",
          "type": "string"
        },
        "failed_implementation_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Failed Implementation Id",
          "type": "string"
        },
        "repaired_implementation_id": {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Repaired Implementation Id",
          "type": "string"
        },
        "failed_code_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Failed Code Hash",
          "type": "string"
        },
        "repaired_code_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Repaired Code Hash",
          "type": "string"
        },
        "failure_category": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Failure Category",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "scope",
        "failed_run_id",
        "failed_implementation_id",
        "repaired_implementation_id",
        "failed_code_hash",
        "repaired_code_hash",
        "failure_category"
      ],
      "title": "RepairEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "experience_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Experience Id",
      "type": "string"
    },
    "condition": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Condition",
      "type": "string"
    },
    "action": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Action",
      "type": "string"
    },
    "outcome": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Outcome",
      "type": "string"
    },
    "source_run_id": {
      "anyOf": [
        {
          "maxLength": 240,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Run Id"
    },
    "verification_status": {
      "default": "proposed",
      "enum": [
        "proposed",
        "verified"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "repair_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepairEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "experience_id",
    "condition",
    "action",
    "outcome"
  ],
  "title": "ExperienceRecord",
  "type": "object"
}
