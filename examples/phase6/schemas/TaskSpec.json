{
  "$defs": {
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "backend": {
          "const": "docker",
          "default": "docker",
          "title": "Backend",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "cpus": {
          "default": 2,
          "minimum": 1,
          "title": "Cpus",
          "type": "integer"
        },
        "memory_mib": {
          "default": 4096,
          "minimum": 128,
          "title": "Memory Mib",
          "type": "integer"
        },
        "network": {
          "const": false,
          "default": false,
          "title": "Network",
          "type": "boolean"
        },
        "fail_closed": {
          "const": true,
          "default": true,
          "title": "Fail Closed",
          "type": "boolean"
        }
      },
      "title": "ExecutionBudget",
      "type": "object"
    },
    "FeatureSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "dtype": {
          "enum": [
            "numeric",
            "categorical",
            "boolean",
            "text"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "nullable": {
          "default": false,
          "title": "Nullable",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dtype"
      ],
      "title": "FeatureSpec",
      "type": "object"
    },
    "MetricRule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "name": {
          "enum": [
            "f1",
            "roc_auc",
            "precision",
            "recall",
            "mae",
            "rmse",
            "macro_f1",
            "accuracy"
          ],
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ],
          "title": "Direction",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "name",
        "direction"
      ],
      "title": "MetricRule",
      "type": "object"
    },
    "TaskConstraints": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "candidate_limit": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Candidate Limit",
          "type": "integer"
        },
        "max_repairs_per_candidate": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Max Repairs Per Candidate",
          "type": "integer"
        },
        "allowed_algorithms": {
          "items": {
            "maxLength": 240,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Allowed Algorithms",
          "type": "array"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionBudget"
        }
      },
      "title": "TaskConstraints",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Description",
      "type": "string"
    },
    "task_type": {
      "enum": [
        "binary_classification",
        "multiclass_classification",
        "regression"
      ],
      "title": "Task Type",
      "type": "string"
    },
    "target": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Target",
      "type": "string"
    },
    "feature_schema": {
      "items": {
        "$ref": "#/$defs/FeatureSpec"
      },
      "minItems": 1,
      "title": "Feature Schema",
      "type": "array"
    },
    "data_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Data Fingerprint",
      "type": "string"
    },
    "split_id": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "title": "Split Id",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricRule"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "constraints": {
      "$ref": "#/$defs/TaskConstraints"
    },
    "seed": {
      "default": 42,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "class_labels": {
      "items": {
        "type": "integer"
      },
      "title": "Class Labels",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "description",
    "task_type",
    "target",
    "feature_schema",
    "data_fingerprint",
    "split_id",
    "metrics"
  ],
  "title": "TaskSpec",
  "type": "object"
}
