      <data key="d7">{"head_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:algorithm:hist_gradient_boosting","id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:relation:applicable:hist_gradient_boosting","schema_version":1,"source_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a","source_span":{"end":713,"quote":"HistGradientBoosting 属于梯度提升分类模型，可以实现客户流失预测能力，适用于上述客户流失二分类任务。本项目先使用数值和类别缺失填补、类别编码的统一预处理，并控制编码后特征规模。","schema_version":1,"start":615},"tail_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:task:churn","type":"APPLICABLE_TO"}</data>
