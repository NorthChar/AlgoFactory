    <edge source="source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:algorithm:random_forest" target="source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:capability:churn" id="source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:relation:implements:random_forest">
      <data key="d6">IMPLEMENTS</data>
      <data key="d7">{"head_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:algorithm:random_forest","id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:relation:implements:random_forest","schema_version":1,"source_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a","source_span":{"end":613,"quote":"Random Forest 属于树集成分类模型，可以实现客户流失预测能力，适用于上述客户流失二分类任务。为统一输入接口，使用前填补数值和类别缺失并编码类别特征，通常不要求数值缩放。","schema_version":1,"start":523},"tail_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:capability:churn","type":"IMPLEMENTS"}</data>
    </edge>
    <edge source="source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:task:churn" target="source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:capability:churn" id="source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:relation:requires">
      <data key="d6">REQUIRES</data>
      <data key="d7">{"head_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:task:churn","id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:relation:requires","schema_version":1,"source_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a","source_span":{"end":432,"quote":"客户流失预测能力接收客户表格特征和训练标签，输出流失类别和流失概率。输入字段包括 tenure_months（数值，允许缺失）、monthly_fee（数值，允许缺失）、support_tickets（数值）和 contract_type（类别，允许缺失）。churn 是标签，不得放入特征。适用条件是有监督标签的表格二分类；数值缺失填补、类别缺失填补及类别编码均只在训练集拟合。评价指标为 F1、ROC-AUC、Precision、Recall；具体通过阈值须经基线校准后冻结，本材料不提供模型成绩或通过阈值。","schema_version":1,"start":176},"tail_id":"source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:capability:churn","type":"REQUIRES"}</data>
    </edge>
