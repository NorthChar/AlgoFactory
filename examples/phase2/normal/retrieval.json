  {
    "record": {
      "conditions": {
        "data_kind": "tabular",
        "requirements": [
          "监督标签",
          "仅在训练集拟合预处理",
          "填补数值和类别缺失",
          "类别编码"
        ],
        "schema_version": 1,
        "task_types": [
          "binary_classification"
        ]
      },
      "description": "从客户表格特征预测流失类别与概率",
      "id": "source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a:capability:churn",
      "inputs": [
        "客户表格特征",
        "训练标签 churn"
      ],
      "metrics": [
        "f1",
        "roc_auc",
        "precision",
        "recall"
      ],
      "name": "客户流失预测能力",
      "outputs": [
        "流失类别",
        "流失概率"
      ],
      "schema_version": 1,
      "source_id": "source:ae8aa246325a083652ad97b25b61c4797ec4e5d66e7e1393c17e68a3ef63136a",
      "source_span": {
        "end": 432,
        "quote": "客户流失预测能力接收客户表格特征和训练标签，输出流失类别和流失概率。输入字段包括 tenure_months（数值，允许缺失）、monthly_fee（数值，允许缺失）、support_tickets（数值）和 contract_type（类别，允许缺失）。churn 是标签，不得放入特征。适用条件是有监督标签的表格二分类；数值缺失填补、类别缺失填补及类别编码均只在训练集拟合。评价指标为 F1、ROC-AUC、Precision、Recall；具体通过阈值须经基线校准后冻结，本材料不提供模型成绩或通过阈值。",
        "schema_version": 1,
        "start": 176
      },
      "type": "Capability"
    },
