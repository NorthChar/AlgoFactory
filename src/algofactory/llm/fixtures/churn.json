          "source_span": {
            "schema_version": 1,
            "start": 20,
            "end": 174,
            "quote": "本材料由 AlgoFactory 项目编写，用于可公开提交的模拟业务演示，不包含真实客户资料。任务是监督式表格二分类，目标字段 churn 表示客户是否流失。任务最多比较 2 个候选，每个候选最多修复 2 次；执行预算为 Docker、120 秒、2 CPU、4096 MiB，禁网，缺少隔离环境时拒绝执行。"
          },
          "type": "Task",
          "name": "客户流失预测",
          "task_type": "binary_classification",
