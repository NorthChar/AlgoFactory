# 复制为 .env；使用 algofactory --env-file .env demo --mode api ... 显式加载。
# 系统环境变量优先。真实密钥只放在被 Git 忽略的 .env，禁止填写到此模板。
ALGOFACTORY_LLM_MODE=mock
ALGOFACTORY_API_KEY=
# Azure 示例：https://your-resource.openai.azure.com/openai/v1/
ALGOFACTORY_API_BASE_URL=
# Azure 填部署名称，不一定等于模型名称。
ALGOFACTORY_API_MODEL=
# chat_completions 或 responses；Azure Responses 可使用 api_key 认证。
ALGOFACTORY_API_STYLE=responses
ALGOFACTORY_API_AUTH_STYLE=api_key
# 单价未知时两项均留空，费用记录为未知，不视作免费。单位 USD / 百万 token。
ALGOFACTORY_API_INPUT_USD_PER_MILLION=
ALGOFACTORY_API_OUTPUT_USD_PER_MILLION=
# 可留空关闭金额限制；若填写金额，必须同时提供两项单价。
ALGOFACTORY_API_MAX_COST_USD=
# 小规模验证：最多 4 次调用，无自动重试，每次最多输出 8192 token。
ALGOFACTORY_API_MAX_CALLS=4
ALGOFACTORY_API_MAX_RETRIES=0
ALGOFACTORY_API_MAX_OUTPUT_TOKENS=8192
ALGOFACTORY_API_TIMEOUT_SECONDS=120
