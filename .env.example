# 复制为 .env 后由 shell 显式加载；程序不自动读取 .env。真实密钥禁止提交。
ALGOFACTORY_LLM_MODE=mock
ALGOFACTORY_API_KEY=
# 服务的兼容 API 根地址，例如 https://your-provider.example/v1
ALGOFACTORY_API_BASE_URL=
ALGOFACTORY_API_MODEL=
# 必须根据所选服务填写实际价格；单位为 USD / 百万 token。
ALGOFACTORY_API_INPUT_USD_PER_MILLION=
ALGOFACTORY_API_OUTPUT_USD_PER_MILLION=
ALGOFACTORY_API_MAX_COST_USD=1.0
